{
  "name": "livium-studio",
  "version": "0.5.0",
  "private": true,
  "description": "React operator console over the Python Livium runtime, served by Node.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "npm run build && node --test test/*.test.mjs && vitest run",
    "test:server": "node --test test/*.test.mjs",
    "test:components": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "vite": "6.4.4",
    "vitest": "5.0.4"
  }
}
