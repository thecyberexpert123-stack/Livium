# Agent Livium configuration. Every value is optional: the defaults are safe, and
# `python3 -m livium doctor` reports what the environment actually provides.
#
# Copy to .env and export it, or set these in your shell:
#   cp .env.example .env && export $(grep -v '^#' .env | xargs)
#
# Every variable below is read by livium/config.py; tests/test_config.py fails if
# this file and the code drift apart in either direction.
#
# Secrets belong here or in your shell -- never in the repository, and never in a
# command the agent can read.

# ---------------------------------------------------------------- where it lives
# Where human-approved capability packages are installed. Defaults to
# LIVIUM_HOME/promoted/; each package's tested files and digests are recorded
# in the DB. An older flat module in the repository is NOT trusted automatically.
# A relative value is resolved under LIVIUM_HOME.
# LIVIUM_PROMOTED_DIR=/some/writable/dir

LIVIUM_HOME=./.livium
# Overridden individually if you want the database or evidence elsewhere:
# LIVIUM_DB=./.livium/livium.db
# LIVIUM_EVIDENCE=./.livium/evidence

# --------------------------------------------------------------------- provider
# openai_compatible | anthropic | ollama | scripted
#   openai_compatible covers OpenAI, OpenRouter, Groq, Together, DeepSeek, vLLM,
#   LM Studio and anything else speaking /chat/completions.
#   scripted is a TEST DOUBLE ONLY: it is refused unless LIVIUM_ALLOW_TEST_DOUBLE=1,
#   and everything it produces is labelled is_test_double.
LIVIUM_PROVIDER=openai_compatible

# Leave empty for local providers (Ollama, LM Studio). The conventional provider
# variables (OPENAI_API_KEY, ANTHROPIC_API_KEY) are accepted as fallbacks.
LIVIUM_API_KEY=

# Override for a custom or self-hosted endpoint, e.g. http://localhost:11434/v1
LIVIUM_BASE_URL=https://api.openai.com/v1

LIVIUM_MODEL=gpt-4o-mini

# The model's real context window. Leave unset to use the provider's figure when the
# endpoint reports one (most do not), then the fallback below. Setting this always
# wins -- do that when you know the number for your deployment.
# LIVIUM_CONTEXT_WINDOW=128000
LIVIUM_FALLBACK_CONTEXT_WINDOW=8192

# Tokens reserved for the reply, held back from the prompt budget.
LIVIUM_MAX_OUTPUT_TOKENS=1024
# Extra fraction of the window held back, as a whole percentage.
LIVIUM_SAFETY_MARGIN_PCT=25

LIVIUM_MODEL_TIMEOUT=120
LIVIUM_MODEL_RETRIES=2
# Sampling temperature, in hundredths, to avoid float parsing surprises:
# 0 = deterministic tool-calling, 70 = 0.7. Some local models need > 0.
LIVIUM_TEMPERATURE_X100=0

# ---------------------------------------------------------------- loop stopping
LIVIUM_MAX_STEPS=12
LIVIUM_MAX_TOOL_CALLS=40
# Retries allowed per tool after a failure that could plausibly differ next time.
# An identical call is never retried: the router changes approach instead.
LIVIUM_MAX_RETRIES_PER_TOOL=2
LIVIUM_MAX_SECONDS=900
LIVIUM_MAX_COMMAND_SECONDS=60
LIVIUM_MAX_TOOL_OUTPUT_BYTES=30000
LIVIUM_MAX_FILE_WRITE_BYTES=400000

# ------------------------------------------------------------ where it may work
# Writes are confined to the workspace and the capability lab. Extras are appended
# to the allowed roots, never substituted, so a mis-set variable cannot hand the
# agent the filesystem.
LIVIUM_WORKSPACE=./.livium/workspace
# LIVIUM_EXTRA_WRITE_ROOTS=/abs/path/one:/abs/path/two

# Paths this deployment refuses to let the agent write, on top of the enforcement
# surface. A path named only here is still refused and still watched; what it lacks is a
# written rationale, and the integrity record says so rather than borrowing one.
# LIVIUM_EXTRA_PROTECTED_PATHS=/abs/path/your/own/rules.py

# The enforcement probes run in their own isolated home and tamper with a file they
# own. `livium integrity verify` sets these two for the probe process only; they are
# documented here because the code reads them, and a deployment that pre-sets a home
# for the probes can point them elsewhere.
# LIVIUM_PROBE_HOME=/abs/path/probe-home
# LIVIUM_PROBE_VICTIM=/abs/path/probe-home/probe-victim.py

# Empty means no network access from the agent at all.
# LIVIUM_NETWORK_ALLOWLIST=api.example.com

# Consequential operations that a human must approve, one operation at a time.
# An approval is a row written by `livium approvals --approve <id> --by <name>`; the
# agent cannot create one, and the deny-list above cannot be overridden by one.
# Paths listed here are writable only with approval (they stay refused otherwise).
# LIVIUM_APPROVAL_WRITE_ROOTS=/abs/path/that/needs/a/human
# Binaries listed here may run only with approval. Note that any binary that is
# neither allow-listed nor denied already returns approval_required, so this list is
# for making that explicit.
# LIVIUM_APPROVAL_BINARIES=

# --------------------------------------------------------------- boundary lists
# The allow-list is the authority; the deny-list removes entries from it and cannot
# be undone by the agent. Shell interpreters are denied as a matter of policy, so
# shell metacharacters stay literal text rather than becoming syntax.
# LIVIUM_ALLOWED_BINARIES=python3,git,ls,cat,grep,wc,head,tail,find,mkdir
# LIVIUM_DENIED_BINARIES=rm,curl,sudo,bash,sh,powershell,cmd,wsl
LIVIUM_ALLOW_TEST_DOUBLE=0

# --------------------------------------------------------- deferred discovery
# Work the agent notices that is *not* the task it is doing is queued, not chased.
# A follow-up cycle runs only after the task's acceptance criteria have been verified,
# inside its own budget; when the budget runs out the remaining items stay queued and
# the stop is recorded with its reason, so a later cycle resumes there.
LIVIUM_FOLLOWUP_ENABLED=1
LIVIUM_FOLLOWUP_MAX_ITEMS=2
LIVIUM_FOLLOWUP_MAX_MODEL_CALLS=6
LIVIUM_FOLLOWUP_MAX_STEPS=6
LIVIUM_FOLLOWUP_MAX_SECONDS=120
LIVIUM_FOLLOWUP_MAX_TOKENS=20000
# A discovery found while evaluating another enters at depth+1. Past this depth it is
# recorded but not investigated: that is what keeps a chain of follow-ups bounded.
LIVIUM_FOLLOWUP_MAX_DEPTH=2

# --------------------------------------------------------------------- serving
# `livium serve` takes the binding as flags, not environment: --host and --port,
# defaulting to 127.0.0.1:8787. The viewer has no authentication; bind it to
# localhost unless you are putting your own authentication in front of it.

LIVIUM_LOG_LEVEL=info

# ------------------------------------------------------------------ test double
# The scripted client is not a provider: it produces no model output and every reply
# it makes is marked as a test double in the journal, the memory and the report. It
# exists so the whole runtime -- loop, tools, permissions, verification, recovery --
# can be exercised without a network, and it is refused unless explicitly enabled.
# LIVIUM_SCRIPT_FILE lets a *separate process* (a demo, the Studio UI, a recovery
# test) drive it: a JSON array of replies, each {"text": ..., "tool_calls": [...]}.
# With no file the double answers "[script exhausted]", which is a real answer.
LIVIUM_ALLOW_TEST_DOUBLE=0
LIVIUM_SCRIPT_FILE=
